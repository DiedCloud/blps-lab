<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_19wo665" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:process id="process-payments" name="Process Payments" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Payment req received">
      <bpmn:outgoing>Flow_1htclvi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_0wlyhs4" name="Prepare transaction">
      <bpmn:extensionElements>
        <zeebe:script expression="=total * 1.1" resultVariable="totalWithTax" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1htclvi</bpmn:incoming>
      <bpmn:outgoing>Flow_0i3qgie</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0bc7rrc" name="Changed credit card">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-credit-card" retries="" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i3qgie</bpmn:incoming>
      <bpmn:outgoing>Flow_0z1bv6m</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0791rdx" name="Payment executed">
      <bpmn:incoming>Flow_0z1bv6m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1htclvi" sourceRef="StartEvent_1" targetRef="Activity_0wlyhs4" />
    <bpmn:sequenceFlow id="Flow_0i3qgie" sourceRef="Activity_0wlyhs4" targetRef="Activity_0bc7rrc" />
    <bpmn:sequenceFlow id="Flow_0z1bv6m" sourceRef="Activity_0bc7rrc" targetRef="Event_0791rdx" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process-payments">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="170" y="145" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0c71k8l_di" bpmnElement="Activity_0wlyhs4">
        <dc:Bounds x="370" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0mld7ln_di" bpmnElement="Activity_0bc7rrc">
        <dc:Bounds x="370" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0791rdx_di" bpmnElement="Event_0791rdx">
        <dc:Bounds x="622" y="162" width="36" height="36" />
