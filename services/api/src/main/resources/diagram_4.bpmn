          <dc:Bounds x="619" y="205" width="45" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1htclvi_di" bpmnElement="Flow_1htclvi">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="370" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0i3qgie_di" bpmnElement="Flow_0i3qgie">
        <di:waypoint x="420" y="160" />
        <di:waypoint x="420" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0z1bv6m_di" bpmnElement="Flow_0z1bv6m">
